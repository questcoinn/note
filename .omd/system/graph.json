        "interaction": {
          "kind": "interactive",
          "state_applicability": {
            "default": {
              "applicability": "applicable"
            },
            "disabled": {
              "applicability": "not-applicable",
              "reason": "폴더 메뉴는 항상 열 수 있으며 비활성 상태를 갖지 않음"
            },
            "error": {
              "applicability": "not-applicable",
              "reason": "메뉴 자체는 검증 실패 상태를 갖지 않으며 실패는 이어지는 다이얼로그에서 표시함"
            },
            "focus-visible": {
              "applicability": "applicable"
            },
            "hover": {
              "applicability": "applicable"
            },
            "loading": {
              "applicability": "not-applicable",
              "reason": "노트 앱의 로컬 저장/렌더링 동작은 즉시 완료되어 로딩 대기 상태가 없음"
            },
            "success": {
              "applicability": "not-applicable",
              "reason": "해당 컴포넌트는 별도의 성공 상태를 표시하지 않음"
            }
          }
        },
        "semantics": "사이드바 폴더 항목 뒤에 항상 보이는 메뉴 버튼과 그 버튼이 여는 popover 메뉴. \"이름 바꾸기\"와 \"삭제\"를 제공하며 삭제는 danger 텍스트로 구분한다. 메뉴 표면은 canvas 배경과 border 경계만 쓰고 그림자를 두지 않는다. 화살표 키로 항목을 이동하고 Esc나 바깥 클릭으로 닫히며 포커스는 메뉴 버튼으로 돌아간다",
        "states": [
