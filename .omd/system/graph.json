          "default",
          "hover",
          "focus-visible",
          "disabled",
          "pressed"
        ],
        "token_refs": [
          "color.primary",
          "color.on-primary",
          "radius.button-xl"
        ],
        "variants": [
          "fill-primary",
          "fill-danger"
        ]
      },
      {
