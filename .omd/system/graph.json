          "color.body",
          "color.canvas",
          "color.border",
          "color.danger",
          "radius.sm",
          "radius.md"
        ],
        "variants": [
          "default",
          "danger-item"
        ]
      },
      {
        "anatomy": [
          "label",
          "select-control"
        ],
        "id": "folder-select",
        "interaction": {
